# Node / build output
node_modules/
out/
dist/
release/
.vite/
*.tsbuildinfo

# Test output
test-results/
playwright-report/
coverage/

# IDE / editor
.vs/
.vscode/
*.user
*.suo
.idea/

# OS
Thumbs.db
desktop.ini
.DS_Store

# GOG game installs (copyrighted content)
GOG Games/

# Reference code (third-party, not redistributable)
.ref/

# Agent transcripts
.agent/

# RE-Enhance mods (copyrighted mod binaries)
reenhancemods/

# Large media inputs to `pnpm assets:sync`. The converted copies the launcher
# actually renders are committed under src/renderer/src/assets/, so a fresh clone
# builds and runs without these; only re-running the sync needs them. RE2.wav is
# not consumed by anything — the legacy `PlayMusic` was a no-op and the new
# launcher has no music playback.
assets/videos/
assets/audio/RE2.wav

# Local launcher runtime state
config.ini
achievements.sav

# Native overlay build output. The plugin is built by `tools/build-native.mjs` (see
# docs/ARCHITECTURE.md §12) and is deliberately NOT committed: it is a binary that goes
# inside someone's game process, so it is built from source on the machine that ships it.
# `native/*/build/` is CMake's own tree; the shipped plugin's artifact lives in
# `resources/` and is produced by `pnpm build:overlay` before packaging.
native/*/build/
native/*/*.asi
native/*/*.exe
resources/*.asi
# Copied from `src/renderer/src/assets/font/` by `pnpm build:overlay`, so the renderer's copy stays
# the single source of truth for the face both toasts are set in.
resources/Actor-Regular.ttf

test-results-*/
